{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shortlist-desk",
  "main": "worker/index.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "workers_dev": true,
  "triggers": {
    "crons": [
      "*/10 * * * *",
      "0 * * * *"
    ]
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/mcp*",
      "/oauth/*",
      "/.well-known/*",
      "/agent",
      "/mail-agent",
      "/admin",
      "/admin/*",
      "/gate/*"
    ]
  },
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "490a121f086e4cc0aa67971d80211b8f" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shortlist-db",
      "database_id": "f88bea3d-cb25-4d88-ac1a-ccaf64f19010",
      "migrations_dir": "migrations"
    }
  ]
}
