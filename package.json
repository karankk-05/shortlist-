{
  "name": "shortlist-desk",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "npm run build && wrangler d1 migrations apply DB --local && wrangler dev --local --port 8787",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test .helper/records.test.mjs .helper/student-view.test.mjs .helper/mail.test.mjs .helper/shortlist-groups.test.mjs .helper/identity-review.test.mjs .helper/library-view.test.mjs .helper/campus-network.test.mjs .helper/usage.test.mjs .helper/oauth-grant.test.mjs",
    "test:integration": "node .helper/integration.mjs",
    "test:events": "node .helper/events.integration.mjs",
    "test:usage": "node .helper/usage.integration.mjs",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "deploy": "npm run build && wrangler deploy",
    "setup:cloudflare": "node .helper/setup-cloudflare.mjs",
    "setup:owner": "node .helper/setup-owner.mjs",
    "setup:mail": "node .helper/setup-mail.mjs",
    "backup": "node .helper/backup.mjs",
    "setup:entry": "node .helper/setup-owner-entry.mjs"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "1.2.4",
    "ipaddr.js": "2.2.0",
    "lucide-react": "^1.31.0",
    "postal-mime": "4.1.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260515.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "esbuild": "^0.27.3",
    "miniflare": "^4.20260515.0",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  }
}
